{
  "info": {
    "_postman_id": "murika-service-api-collection",
    "name": "Murika Service API",
    "description": "Collection endpoint untuk Murika Service API (Go + Gin + GORM)\n\n## Setup\n1. Jalankan request **Login** terlebih dahulu\n2. Token akan otomatis tersimpan ke variable `{{token}}`\n3. Semua request di folder **Protected** akan otomatis menggunakan token tersebut",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string",
      "description": "Base URL service API Go"
    },
    {
      "key": "token",
      "value": "",
      "type": "string",
      "description": "JWT Bearer token (otomatis diisi setelah login)"
    }
  ],
  "item": [
    {
      "name": "🔓 Auth",
      "description": "Endpoint autentikasi (publik, tidak perlu token)",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const res = pm.response.json();",
                  "    pm.collectionVariables.set('token', res.token);",
                  "    console.log('Token berhasil disimpan:', res.token);",
                  "} else {",
                  "    console.log('Login gagal:', pm.response.json());",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"admin@elmu.com\",\n    \"password\": \"password123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Login menggunakan email dan password. Token JWT otomatis tersimpan ke {{token}} setelah sukses."
          },
          "response": [
            {
              "name": "Login Berhasil (200)",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n    \"token\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJlbWFpbCI6ImFkbWluQGVsbXUuY29tIiwiZXhwIjoxNzIxNzc2MDAwLCJpYXQiOjE3MjE2ODk2MDAsIm5hbWUiOiJhZG1pbiIsInJvbGUiOjAsInN1YiI6MX0.abc123\",\n    \"token_type\": \"Bearer\",\n    \"expires_in\": 86400,\n    \"user\": {\n        \"id\": 1,\n        \"name\": \"admin\",\n        \"email\": \"admin@elmu.com\",\n        \"role\": 0,\n        \"status\": 1\n    }\n}"
            },
            {
              "name": "Email atau Password Salah (401)",
              "status": "Unauthorized",
              "code": 401,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n    \"error\": \"Email atau password salah\"\n}"
            },
            {
              "name": "Akun Tidak Aktif (403)",
              "status": "Forbidden",
              "code": 403,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n    \"error\": \"Akun Anda tidak aktif. Hubungi administrator.\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "👥 Users (Public)",
      "description": "Endpoint manajemen user (publik, tidak perlu token)",
      "item": [
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/users",
              "host": ["{{base_url}}"],
              "path": ["users"]
            },
            "description": "Mengambil semua data user dari database."
          },
          "response": [
            {
              "name": "Success (200)",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "[\n    {\n        \"id\": 1,\n        \"name\": \"admin\",\n        \"email\": \"admin@elmu.com\",\n        \"role\": 0,\n        \"status\": 1\n    },\n    {\n        \"id\": 2,\n        \"name\": \"budi_guru\",\n        \"email\": \"budi@elmu.com\",\n        \"role\": 3,\n        \"status\": 1\n    }\n]"
            }
          ]
        },
        {
          "name": "Get User By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/users/1",
              "host": ["{{base_url}}"],
              "path": ["users", "1"]
            },
            "description": "Mengambil data user berdasarkan ID."
          },
          "response": [
            {
              "name": "Found (200)",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n    \"id\": 1,\n    \"name\": \"admin\",\n    \"email\": \"admin@elmu.com\",\n    \"role\": 0,\n    \"status\": 1\n}"
            },
            {
              "name": "Not Found (404)",
              "status": "Not Found",
              "code": 404,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n    \"message\": \"User not found\"\n}"
            }
          ]
        },
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"user_baru\",\n    \"email\": \"userbaru@elmu.com\",\n    \"role\": 3,\n    \"status\": 1\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/users",
              "host": ["{{base_url}}"],
              "path": ["users"]
            },
            "description": "Membuat user baru."
          },
          "response": [
            {
              "name": "Created (200)",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n    \"id\": 10,\n    \"name\": \"user_baru\",\n    \"email\": \"userbaru@elmu.com\",\n    \"role\": 3,\n    \"status\": 1\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "🔐 Dashboard (Protected - JWT Required)",
      "description": "Endpoint dashboard yang memerlukan JWT Bearer Token. Pastikan sudah login terlebih dahulu agar {{token}} terisi otomatis.",
      "item": [
        {
          "name": "Salary - Default (Bulan & Tahun Ini)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "description": "JWT token dari hasil login"
              }
            ],
            "url": {
              "raw": "{{base_url}}/dashboard/salary",
              "host": ["{{base_url}}"],
              "path": ["dashboard", "salary"]
            },
            "description": "Mengambil data salary guru. Tanpa parameter menggunakan bulan dan tahun saat ini."
          },
          "response": [
            {
              "name": "Success (200)",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n    \"items\": [\n        {\n            \"id\": 1,\n            \"user\": 5,\n            \"unit_id\": 1,\n            \"birth\": \"1995-04-12\",\n            \"unit\": {\n                \"id\": 1,\n                \"name\": \"Unit Cabang A\"\n            },\n            \"akun\": {\n                \"id\": 5,\n                \"name\": \"Budi Sugiantoro\",\n                \"email\": \"budi@elmu.com\",\n                \"role\": 3,\n                \"status\": 1\n            },\n            \"salaries\": [\n                {\n                    \"id\": 12,\n                    \"teach_id\": 1,\n                    \"nominal\": 2500000,\n                    \"status\": 1,\n                    \"tanggal\": \"2026-07-28T00:00:00Z\",\n                    \"sesi\": 20,\n                    \"persentase\": 100,\n                    \"total\": 2500000,\n                    \"jumlah_pertemuan\": 20\n                }\n            ],\n            \"present\": [\n                {\n                    \"id\": 150,\n                    \"student_id\": 10,\n                    \"teach_id\": 1,\n                    \"head_id\": 8,\n                    \"program_id\": 1,\n                    \"Materi\": \"Membaca tingkat awal\",\n                    \"Keterangan\": \"Hadir\",\n                    \"student\": {\n                        \"id\": 10,\n                        \"name\": \"Adit\",\n                        \"nama_panggilan\": \"Adit\"\n                    },\n                    \"program\": {\n                        \"id\": 1,\n                        \"name\": \"Calistung\",\n                        \"kode\": \"CLS\"\n                    },\n                    \"reg\": {\n                        \"id\": 8,\n                        \"units\": { \"id\": 1, \"name\": \"Unit Cabang A\" },\n                        \"product\": { \"id\": 3, \"harga\": 150000 }\n                    }\n                }\n            ],\n            \"present_count\": 1\n        }\n    ],\n    \"month\": 7,\n    \"year\": 2026,\n    \"unit\": \"\",\n    \"units\": [\n        { \"id\": 1, \"name\": \"Unit Cabang A\" },\n        { \"id\": 2, \"name\": \"Unit Cabang B\" }\n    ]\n}"
            }
          ]
        },
        {
          "name": "Salary - Filter Bulan & Tahun",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/dashboard/salary?month=7&year=2026",
              "host": ["{{base_url}}"],
              "path": ["dashboard", "salary"],
              "query": [
                { "key": "month", "value": "7", "description": "Bulan (1-12)" },
                { "key": "year", "value": "2026", "description": "Tahun" }
              ]
            },
            "description": "Filter data salary berdasarkan bulan dan tahun tertentu."
          },
          "response": []
        },
        {
          "name": "Salary - Filter Bulan, Tahun & Unit",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/dashboard/salary?month=7&year=2026&unit=1",
              "host": ["{{base_url}}"],
              "path": ["dashboard", "salary"],
              "query": [
                { "key": "month", "value": "7", "description": "Bulan (1-12)" },
                { "key": "year", "value": "2026", "description": "Tahun" },
                { "key": "unit", "value": "1", "description": "ID Unit/Cabang" }
              ]
            },
            "description": "Filter data salary berdasarkan bulan, tahun, dan unit/cabang tertentu."
          },
          "response": []
        },
        {
          "name": "Salary - Token Invalid (Contoh Error 401)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer token_tidak_valid" }
            ],
            "url": {
              "raw": "{{base_url}}/dashboard/salary",
              "host": ["{{base_url}}"],
              "path": ["dashboard", "salary"]
            },
            "description": "Contoh request dengan token tidak valid untuk melihat response error 401."
          },
          "response": [
            {
              "name": "Unauthorized (401)",
              "status": "Unauthorized",
              "code": 401,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n    \"error\": \"Token tidak valid atau sudah kadaluarsa\"\n}"
            },
            {
              "name": "No Token (401)",
              "status": "Unauthorized",
              "code": 401,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n    \"error\": \"Authorization header tidak ditemukan\"\n}"
            }
          ]
        }
      ]
    }
  ]
}
